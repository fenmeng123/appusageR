#!/bin/sh

blocked_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -Ei '(^|/)apptypedict/.*\.(xls|xlsx|xlsm)$')

if [ -n "$blocked_files" ]; then
  echo "ERROR: App Category Dictionary Excel files under apptypedict/ must not be committed." >&2
  echo "Convert the dictionary to a CRAN-compatible package data object in a future planned change instead." >&2
  echo "$blocked_files" >&2
  exit 1
fi
